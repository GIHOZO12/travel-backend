# Copy this file to .env and fill in your real local values. Never commit .env.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/travel_tour"

# Server
PORT=5000

NODE_ENV=development

# CORS - the Next.js frontend origin
CLIENT_URL="http://localhost:3000"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Email notifications (optional). Set ONE of the two options below; with
# neither, the API just logs "[email] skipped".
COMPANY_NAME="Ingata Travel"

# Option 1 (use on Render's free tier, which blocks outbound SMTP):
# Resend sends over HTTPS. Get a key at https://resend.com/api-keys.
# RESEND_FROM must be an address on a domain verified in Resend; leave it
# empty to use Resend's sandbox sender, which only delivers to the email
# address that owns the Resend account.
RESEND_API_KEY=""
RESEND_FROM=""

# Option 2: any SMTP server (Gmail app password, Brevo, Mailgun, ...).
# Ignored when RESEND_API_KEY is set.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="bookings@yourdomain.com"
# Staff inbox that receives "new booking / new inquiry" emails
NOTIFY_EMAIL="info@yourdomain.com"

# Seed admin — used ONLY by `npm run seed` to create the first
# admin account. Change these before seeding a real environment.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@travel-tour.local"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# ---------- Docker only (docker-compose.yml) ----------
# Credentials for the PostgreSQL container. The api container builds its own
# DATABASE_URL from these, so the DATABASE_URL above is only used when you run
# the API without Docker (npm run dev).
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="travel_tour"
# npm registry used while building the image. Use https://registry.yarnpkg.com
# if registry.npmjs.org is blocked on your network.
NPM_REGISTRY="https://registry.npmjs.org"

# Docker image name + version used by `docker compose build/push` (DOCKER.md, Part 7)
# API_IMAGE=yourname/travel-tour-api:1.0.0
# Host port for the API container (default 5000)
# API_PORT=5000
