# Copy this file to .env and fill in your real local values. Never commit .env.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/travel_tour?schema=public"

# Server
PORT=5000

NODE_ENV=development

# CORS - the Next.js frontend origin
CLIENT_URL="http://localhost:3000"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Email notifications (optional). Leave SMTP_HOST empty to disable sending;
# the API then just logs "[email] skipped". Works with any SMTP provider
# (Gmail app password, Brevo, Mailgun, your hosting's mail server, ...).
COMPANY_NAME="Ingata Travel"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="bookings@yourdomain.com"
# Staff inbox that receives "new booking / new inquiry" emails
NOTIFY_EMAIL="info@yourdomain.com"

# Seed admin — used ONLY by `npx prisma db seed` to create the first
# admin account. Change these before seeding a real environment.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@travel-tour.local"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
