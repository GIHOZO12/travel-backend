# Copy this file to .env and fill in your real local values. Never commit .env.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/travel_tour?schema=public"

# Server
PORT=5000

NODE_ENV=development

# CORS - the Next.js frontend origin
CLIENT_URL="http://localhost:3000"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
