{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,

    // Needed by TypeORM's @Entity / @Column decorators.
    "experimentalDecorators": true,
    // Entity properties are filled in by TypeORM, not a constructor.
    "strictPropertyInitialization": false,
    // Stops class fields being initialised to `undefined`, which TypeORM entities don't expect.
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
