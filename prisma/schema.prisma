// Prisma schema — this file is the single source of truth for our database
// structure. Every table ("model") below becomes a real PostgreSQL table
// when we run `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Admin / Auth ----------

model AdminUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String // stored as a bcrypt hash, never plain text
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

// ---------- Destinations ----------

model Destination {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  country         String
  overview        String
  attractions     String[] @default([])
  activities      String[] @default([])
  bestTimeToVisit String?
  heroImage       String?
  images          String[] @default([])
  isFeatured      Boolean  @default(false)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tours Tour[]

  @@map("destinations")
}

// ---------- Tours ----------

model Tour {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  category       String // e.g. "Wildlife Safari", "Gorilla Trekking", "Cultural Tour"
  durationDays   Int
  durationNights Int
  startingPrice  Decimal? @db.Decimal(10, 2)
  currency       String   @default("USD")
  overview       String
  highlights     String[] @default([])
  inclusions     String[] @default([])
  exclusions     String[] @default([])
  requirements   String[] @default([])
  featuredImage  String?
  images         String[] @default([])
  isFeatured     Boolean  @default(false)
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  destination     Destination      @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  destinationId   Int
  itineraryDays   ItineraryDay[]
  inquiries       Inquiry[]
  bookingRequests BookingRequest[]

  @@map("tours")
}

model ItineraryDay {
  id         Int      @id @default(autoincrement())
  dayNumber  Int
  title      String
  activities String[] @default([])

  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  tourId Int

  @@unique([tourId, dayNumber])
  @@map("itinerary_days")
}

// ---------- Leads: inquiries & booking requests ----------

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Inquiry {
  id                Int           @id @default(autoincrement())
  fullName          String
  email             String
  phone             String?
  destinationName   String? // free-text fallback if no specific tour selected
  preferredDate     DateTime?
  numberOfTravelers Int?
  message           String?
  status            InquiryStatus @default(NEW)
  createdAt         DateTime      @default(now())

  tour   Tour? @relation(fields: [tourId], references: [id], onDelete: SetNull)
  tourId Int?

  @@map("inquiries")
}

enum BookingStatus {
  NEW
  PENDING
  AWAITING_CUSTOMER
  AWAITING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

model BookingRequest {
  id                Int           @id @default(autoincrement())
  fullName          String
  email             String
  phone             String
  nationality       String?
  travelDate        DateTime
  numberOfTravelers Int
  accommodationPref String?
  specialRequests   String?
  status            BookingStatus @default(NEW)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Restrict)
  tourId Int

  @@map("booking_requests")
}

// ---------- Content: FAQs, testimonials, blog ----------

model FAQ {
  id          Int     @id @default(autoincrement())
  question    String
  answer      String
  order       Int     @default(0)
  isPublished Boolean @default(true)

  @@map("faqs")
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  customerName String
  country      String?
  category     String? // e.g. "Family", "Honeymoon", "Corporate"
  content      String
  photo        String?
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("testimonials")
}

model BlogPost {
  id            Int       @id @default(autoincrement())
  title         String
  slug          String    @unique
  content       String
  featuredImage String?
  author        String?
  category      String?
  tags          String[]  @default([])
  isPublished   Boolean   @default(true)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("blog_posts")
}
